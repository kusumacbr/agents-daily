# Primary provider: 'gemini' or 'openrouter'
PROVIDER=gemini

# Gemini Configuration (Free tier: 15 RPM / 1500 RPD)
# Obtain a free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# OpenRouter Configuration (Free tier: 50 requests/day)
# Obtain a free key at https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=poolside/laguna-s-2.1:free
